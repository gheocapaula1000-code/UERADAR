{
  "manifest_version": "1.0.0",
  "product": "trovabandi-app",
  "migrations": [
    "20260806043000_company_profile_matching_fields.sql",
    "20260806044000_daily_notifications.sql"
  ],
  "functions": [
    {
      "name": "trovabandi-digest",
      "verify_jwt": false,
      "auth_mode": "custom_cron_secret_server_to_server",
      "required_secrets": [
        "TROVABANDI_CRON_SECRET",
        "CENTRAL_CORE_API_URL",
        "CENTRAL_CORE_API_KEY",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY"
      ],
      "optional_secrets": [
        "RESEND_API_KEY",
        "TROVABANDI_EMAIL_FROM"
      ]
    },
    {
      "name": "trovabandi-feed",
      "verify_jwt": false,
      "auth_mode": "manual_user_jwt_verification",
      "required_secrets": [
        "CENTRAL_CORE_API_URL",
        "CENTRAL_CORE_API_KEY",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY"
      ],
      "optional_secrets": []
    }
  ],
  "notes": [
    "Email digest is opt-in. In-app notifications work without Resend.",
    "Do not expose server secrets through VITE_* variables.",
    "trovabandi-feed uses verify_jwt=false only to verify the user JWT manually via supabase.auth.getUser(token); it is fail-closed without an authenticated user."
  ]
}
